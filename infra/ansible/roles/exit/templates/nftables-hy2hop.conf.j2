#!/usr/sbin/nft -f
# Managed by anysda-vpn2 stage 10-foreign. Перезаписывается каждым прогоном.
{# Outbound entry раз в HY2_HOP_INTERVAL переходит на другой порт диапазона
   своего канала, экзит перенаправляет диапазон на порт канала: фильтр
   провайдера по 5-tuple режет один поток, а не канал. Порт канала внутри
   диапазона из него исключается. Таблица своя: ufw и docker не трогаются. #}
{% set listen = {'direct': vpn2_env.HY2_DIRECT_PORT | int, 'warp': vpn2_env.HY2_WARP_PORT | int,
                 'mgmt': vpn2_env.HY2_MGMT_PORT | int} %}
table inet vpn2_hy2hop
delete table inet vpn2_hy2hop
table inet vpn2_hy2hop {
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
{% for channel, range in [('direct', exit_hop_direct), ('warp', exit_hop_warp), ('mgmt', exit_hop_mgmt)] %}
{% set low, high = range.split('-') | map('int') %}
        udp dport {{ range }}{% for port in listen.values() if low <= port <= high %} udp dport != {{ port }}{% endfor %} redirect to :{{ listen[channel] }}
{% endfor %}
    }
}
