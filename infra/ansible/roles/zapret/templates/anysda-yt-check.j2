#!/usr/bin/env bash
YT_MARK={{ zapret_v.mark_sh }}
YT_ZAPRET_BASE={{ zapret_v.base_sh }}
DIAG_UID={{ zapret_v.diag_uid }}
DIAG_GID={{ zapret_v.diag_gid }}
YT_ZAPRET_QUEUE={{ zapret_v.queue_sh }}
# A/B-проверка десинка YouTube на одном хосте: A - от диаг-пользователя (метка $YT_MARK,
# десинк), B - от root без метки (контроль). Выход: 0 - путь живой; 1 - обход сломан; 2 - не измерено.
set -uo pipefail
# vpn2 - команда пакета из его venv.
PATH=/opt/vpn2/venv/bin:$PATH
HOST="${1:-https://www.youtube.com/}"
TMO="${YT_CHECK_TIMEOUT:-15}"

for tool in systemctl awk nft vpn2 setpriv curl date; do
  command -v "$tool" >/dev/null || { echo "UNKNOWN: нет утилиты $tool."; exit 2; }
done

path_ready() {
  systemctl is-active --quiet anysda-yt-nft.service anysda-yt-nfqws.service || return 1
  local pid
  pid=$(systemctl show -p MainPID --value anysda-yt-nfqws.service) || return 1
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  awk -v q="$YT_ZAPRET_QUEUE" -v p="$pid" \
    '$1 == q && $2 == p { found = 1 } END { exit !found }' /proc/net/netfilter/nfnetlink_queue
}
queued_packets() {
  nft -j list table inet ytzapret | vpn2 zapret queued "$YT_ZAPRET_QUEUE"
}
if ! path_ready || ! before=$(queued_packets); then
  echo "FAIL: nft-правила или очередь nfqws2 не готовы."
  exit 1
fi

probe() { curl -q -4 --noproxy '*' -sS -o /dev/null -m "$TMO" -w '%{http_code}' "$HOST" 2>/dev/null; }

t0=$(date +%s%N)
arc=0
A=$(setpriv --reuid="$DIAG_UID" --regid="$DIAG_GID" --clear-groups \
      curl -q -4 --noproxy '*' -sS -o /dev/null -m "$TMO" -w '%{http_code}' "$HOST" 2>/dev/null) || arc=$?
A=${A:-000}
case $arc in
  0|7|18|28|35|52|55|56) ;;
  *) echo "UNKNOWN: диагностика не выполнена, curl/setpriv=$arc."; exit 2 ;;
esac
if [[ $A != 000 && ! $A =~ ^(200|204|30[0-9])$ ]]; then
  echo "UNKNOWN: HTTP $A не позволяет измерить обход."
  exit 2
fi
(( arc == 0 )) || A=000
if ! path_ready || ! after=$(queued_packets) || (( after <= before )); then
  echo "FAIL: проба не подтвердила прохождение очереди nfqws2."
  exit 1
fi
# Вердикт решает A. Прошёл A - B ждём втрое дольше A (3 с..TMO), упал - полный TMO.
btmo=$TMO
if [[ "$A" =~ ^(200|204|30[0-9])$ ]]; then
  ms=$(( ($(date +%s%N) - t0) / 1000000 * 3 ))
  (( ms < 3000 )) && ms=3000
  (( ms < TMO * 1000 )) && btmo=$(( ms / 1000 )).$(printf %03d $(( ms % 1000 )))
fi
B=$(TMO=$btmo probe) || B=000
B=${B:-000}

echo "zapret (метка $YT_MARK): $A"
echo "контроль (без метки):    $B"
echo "Проверен только $HOST по IPv4; CDN-видео и путь VPN-клиента проверяются отдельно."

if [[ "$A" =~ ^(200|204|30[0-9])$ ]]; then
  if [[ "$B" =~ ^(200|204|30[0-9])$ ]]; then
    echo "OK: путь десинка работает. Контроль тоже прошёл — DPI сейчас не режет,"
    echo "    тест десинк не доказывает, но и не опровергает."
  else
    echo "OK: путь десинка работает, прямой путь режется DPI — обход делает своё дело."
  fi
  exit 0
fi
echo "FAIL: YouTube не открывается по помеченному пути — клиенты его не увидят."
echo "  журнал:   journalctl -u anysda-yt-nfqws -n 30 --no-pager"
echo "  счётчики: nft list table inet ytzapret"
echo "  подбор стратегии: $YT_ZAPRET_BASE/blockcheck2.sh"
echo "  первое, что пробовать: YT_ZAPRET_OFFLOAD=off (TSO/GSO склеивает ClientHello)"
exit 1
