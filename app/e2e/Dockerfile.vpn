ARG PANEL_IMAGE=vpn2-panel:e2e
FROM ${PANEL_IMAGE}
USER 0:0
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 procps wireguard-tools iproute2 openssl openvpn strongswan-charon strongswan-swanctl libcharon-extra-plugins libstrongswan-standard-plugins \
  && rm -rf /var/lib/apt/lists/*
