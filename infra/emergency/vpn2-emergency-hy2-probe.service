[Unit]
Description=Readiness probe of temporary emergency Hysteria2
After=vpn2-emergency-hy2.service

[Service]
Type=oneshot
User=vpn2-emergency
Group=vpn2-emergency
UMask=0077
WorkingDirectory=/opt/vpn2-emergency
ExecStart=/usr/bin/python3 -B -m vpn2.emergency hy2 probe
TimeoutStartSec=40
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/vpn2-emergency/hy2
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
