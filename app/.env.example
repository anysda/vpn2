# --- sessions (REQUIRED, минимум 32 случайных символа) ---
NUXT_SESSION_PASSWORD=changeme-changeme-changeme-changeme-1234567890

# --- БД ---
DATABASE_URL=file:./local.db

# --- Shadowsocks server config ---
NUXT_SS_CONFIG_PATH=/etc/outline-ss-server/config.yml
NUXT_SS_PORT=443
NUXT_SS_CIPHER=chacha20-ietf-poly1305
NUXT_SS_PUBLIC_HOST=

# --- Anysda integration ---
NUXT_ANYSDA_CONFIG_PATH=/etc/anysda/config.yaml
NUXT_ROUTES_FILE_PATH=/etc/anysda/manual-routes.json

# --- Monitoring ---
NUXT_VM_URL=http://127.0.0.1:8428
NUXT_CLASH_API_URL=http://10.99.0.1:9090
NUXT_CLASH_SECRET=
NUXT_AGH_URL=http://127.0.0.1:3000
NUXT_AGH_USER=
NUXT_AGH_PASSWORD=

# --- Multi-node ---
NUXT_EXIT_TAGS=us gb nl
NUXT_MGMT_MESH_IP_PREFIX=10.99.0.

# --- Telegram bot ---
NUXT_TGBOT_EVENT_PORT=8877
NUXT_TGBOT_SECRET=

# --- Logs ---
LOG_LEVEL=info
