{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Установочный мигратор и сквозные фикстуры запускаются вне Nuxt.
  "ignoreBinaries": ["flock", "openssl"],
  // Сквозные тесты (e2e/*.spec.ts) knip берёт сам через плагин playwright.
  // Подставные VictoriaMetrics и clash API e2e/run-local.sh копирует в контейнер
  // панели по пути и запускает node, импорта нет. Наполнитель front-test
  // e2e/front-test.sh запускает node в образе стадии builder, тоже без импорта.
  // Мигратор запускает deploy в контейнере, а не импорт приложения.
  "entry": ["scripts/migrate.mjs!", "scripts/control-probe.mjs!", "e2e/support/fake-backends.mjs", "e2e/support/front-test-seed.mjs", "e2e/support/admin-password-check.mjs", "e2e/support/config-error-check.mjs", "e2e/support/long-password-check.mjs", "e2e/support/pool-upgrade.mjs", "e2e/support/wg-endpoint-check.mjs", "e2e/support/sso-secret-check.mjs"],
  // Суффикс ! — шаблон для --production. Там тесты не входы, и e2e/support
  // выглядел бы мёртвым; без ! у первого шаблона прод-прогон не видит ни одного файла.
  "project": ["**/*.{js,mjs,cjs,ts,mts,cts,vue,css}!", "!e2e/**!"],
  "ignoreDependencies": [
    // @nuxt/icon (из @nuxt/ui, режим local) берёт коллекцию по имени иконки
    // в шаблонах: i-lucide-copy, i-lucide-x и т.д. Импорта в коде нет.
    "@iconify-json/lucide",
    // То же для i-simple-icons-telegram и i-simple-icons-adguard.
    "@iconify-json/simple-icons",
    // server/utils/logger.ts: pino грузит transport строкой
    // target: 'pino-pretty' (вне production). Импорта в коде нет.
    "pino-pretty",
    // Шрифт аварийной панели Vite берёт из url() в CSS, импорта из JS нет.
    "@fontsource-variable/manrope"
  ]
}
