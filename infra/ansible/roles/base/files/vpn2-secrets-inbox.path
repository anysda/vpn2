# anysda-vpn - пишет роль base, руками не править
# Секрет, заданный в панели, панель кладёт в /run/vpn2-secrets/inbox; переносит его в хранилище root.
[Unit]
Description=vpn2: секреты из панели в хранилище
After=vpn2-secrets.service

[Path]
DirectoryNotEmpty=/run/vpn2-secrets/inbox

[Install]
WantedBy=paths.target
