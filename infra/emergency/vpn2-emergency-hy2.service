[Unit]
Description=Temporary emergency Hysteria2
# Lives only inside its agent: stopping the agent closes the port, a restart
# of the agent restarts it after the agent, which resumes the same generation.
BindsTo=vpn2-emergency.service
After=network-online.target nftables.service vpn2-emergency.service
Wants=network-online.target

[Service]
Type=simple
User=vpn2-hy2
Group=vpn2-emergency
UMask=0027
BindReadOnlyPaths=/var/lib/vpn2-emergency/hy2:/run/vpn2-emergency-hy2
ExecStartPre=+/usr/bin/python3 /opt/vpn2-emergency/vpn2_emergency/hy2.py open
ExecStart=/usr/local/bin/sing-box run -c /run/vpn2-emergency-hy2/server.json
ExecStopPost=+/usr/bin/python3 /opt/vpn2-emergency/vpn2_emergency/hy2.py close
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# No [Install]: only the leader agent starts this unit, never boot targets.
