# anysda-vpn - пишет роль base, руками не править
# Секреты из зашифрованного хранилища в /run/vpn2-secrets до sysinit.target: раньше docker и всех служб.
[Unit]
Description=vpn2: секреты из хранилища в /run/vpn2-secrets
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target shutdown.target
Conflicts=shutdown.target
ConditionPathIsDirectory=/var/lib/vpn2-secrets

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/vpn2/venv/bin/python -I -m vpn2.cli creds publish

[Install]
WantedBy=sysinit.target
