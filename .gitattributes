# Shell scripts and config files must use LF — они выполняются на Linux нодах
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.env       text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf

# Default: let git decide based on content
*           text=auto
