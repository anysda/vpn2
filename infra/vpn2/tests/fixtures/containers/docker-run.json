{
 "anysda-vpn2": [
  "run",
  "-d",
  "--name",
  "anysda-vpn2",
  "--label",
  "vpn2.spec=SPEC",
  "--memory",
  "192m",
  "--memory-swap",
  "192m",
  "-e",
  "NODE_OPTIONS=--max-old-space-size=128",
  "--restart",
  "always",
  "--log-driver",
  "json-file",
  "--log-opt",
  "max-size=10m",
  "--log-opt",
  "max-file=3",
  "--network",
  "host",
  "--user",
  "990:991",
  "--group-add",
  "989",
  "--cap-drop",
  "ALL",
  "--security-opt",
  "no-new-privileges",
  "-v",
  "/etc/localtime:/etc/localtime:ro",
  "-v",
  "/etc/vpn2/tls/panel:/run/vpn2-tls:ro",
  "-v",
  "/etc/anysda/anysda-config.yaml:/etc/anysda/config.yaml:ro",
  "-v",
  "/run/vpn2-control:/run/vpn2-control:ro",
  "-v",
  "/var/lib/anysda-vpn2:/var/lib/anysda-vpn2",
  "-e",
  "NODE_ENV=production",
  "-e",
  "PORT=51821",
  "-e",
  "HOST=127.0.0.1",
  "-e",
  "NUXT_SESSION_PASSWORD=sess",
  "-e",
  "NUXT_DATABASE_URL=file:/var/lib/anysda-vpn2/db.sqlite",
  "-e",
  "NUXT_ANYSDA_CONFIG_PATH=/etc/anysda/config.yaml",
  "-e",
  "NUXT_WG_ENABLED=true",
  "-e",
  "NUXT_WG_LISTEN_PORT=51820",
  "-e",
  "NUXT_WG_SERVER_IP=10.66.66.1",
  "-e",
  "NUXT_WG_SUBNET_PREFIX=10.66.66.",
  "-e",
  "NUXT_WG_PUBLIC_HOST=198.51.100.7",
  "-e",
  "NUXT_WG_ENDPOINT_IP=198.51.100.7",
  "-e",
  "NUXT_NODE_HOSTS=ru=198.51.100.7,de=203.0.113.5,us-east=us.example.org",
  "-e",
  "NUXT_PREVIOUS_NODE_HOSTS=ru=198.51.100.1",
  "-e",
  "NUXT_WG_MTU=1380",
  "-e",
  "NUXT_WG_SPLIT_LOCAL=true",
  "-e",
  "NUXT_OVPN_ENABLED=true",
  "-e",
  "NUXT_OVPN_PORT=1194",
  "-e",
  "NUXT_OVPN_PROTO=tcp",
  "-e",
  "NUXT_OVPN_PUBLIC_HOST=198.51.100.7",
  "-e",
  "NUXT_CLASH_SECRET=clash$ecret",
  "-e",
  "NUXT_CLASH_API_URL=http://10.99.0.1:9090",
  "-e",
  "NUXT_AGH_URL=http://127.0.0.1:3000",
  "-e",
  "NUXT_AGH_USER=owner",
  "-e",
  "NUXT_AGH_PASSWORD=agh-p$a\"ss",
  "-e",
  "NUXT_EXIT_TAGS=de us-east",
  "-e",
  "NUXT_MGMT_MESH_IP_PREFIX=10.99.0.",
  "-e",
  "NUXT_MGMT_IPS=ru:10.99.0.1,de:10.99.0.2,us-east:10.99.0.3",
  "-e",
  "NUXT_VM_URL=http://127.0.0.1:8428",
  "-e",
  "NUXT_TGBOT_SECRET=bot-secret",
  "-e",
  "NUXT_TGBOT_EVENT_PORT=8877",
  "-e",
  "NUXT_PUBLIC_SSO_ENABLED=true",
  "-e",
  "NUXT_PUBLIC_SSO_AUTO_REDIRECT=true",
  "-e",
  "NUXT_PUBLIC_SSO_LABEL=Вход",
  "-e",
  "NUXT_SSO_ALLOWED_SUBS=a,b",
  "-e",
  "NUXT_SSO_PASSWORD_LOGIN=false",
  "-e",
  "NUXT_OAUTH_OIDC_CLIENT_ID=cid",
  "-e",
  "NUXT_OAUTH_OIDC_CLIENT_SECRET=s$1",
  "-e",
  "NUXT_OAUTH_OIDC_OPENID_CONFIG=https://sso.example.org/.well-known",
  "-e",
  "NUXT_OAUTH_OIDC_REDIRECT_URL=https://panel.example.org/auth/authentik",
  "-e",
  "LOG_LEVEL=info",
  "sha256:panel",
  "sh",
  "-ec",
  "export NUXT_SESSION_COOKIE_SECURE=$(cat /run/vpn2-tls/secure); exec node .output/server/index.mjs"
 ],
 "anysda-tgbot": [
  "run",
  "-d",
  "--name",
  "anysda-tgbot",
  "--memory",
  "64m",
  "--memory-swap",
  "64m",
  "--restart",
  "always",
  "--log-driver",
  "json-file",
  "--log-opt",
  "max-size=10m",
  "--log-opt",
  "max-file=3",
  "--network",
  "host",
  "--user",
  "993:992",
  "--group-add",
  "991",
  "--cap-drop",
  "ALL",
  "--security-opt",
  "no-new-privileges",
  "-v",
  "/etc/localtime:/etc/localtime:ro",
  "-v",
  "/var/lib/anysda-vpn2/runtime/telegram-runtime.json:/etc/anysda/telegram-runtime.json:ro",
  "-v",
  "/var/lib/anysda-tgbot:/var/lib/anysda-tgbot",
  "-e",
  "TELEGRAM_BOT_TOKEN=123:abc",
  "-e",
  "TELEGRAM_CHAT_ID=-100",
  "-e",
  "TELEGRAM_ADMIN_USERNAME=boss",
  "-e",
  "TGBOT_SECRET=bot-secret",
  "-e",
  "TGBOT_EVENT_PORT=8877",
  "-e",
  "TGBOT_POLL_STALL_SEC=300",
  "-e",
  "ANYSDA_URL=http://127.0.0.1:51821",
  "-e",
  "TG_PROXY=http://127.0.0.1:7897",
  "-e",
  "ALERT_CPU_PCT=90",
  "-e",
  "TGBOT_INVALID_TOKEN_PAUSE_SEC=5",
  "sha256:bot"
 ],
 "vmsingle": [
  "run",
  "-d",
  "--name",
  "vmsingle",
  "--memory",
  "128m",
  "--memory-swap",
  "128m",
  "--restart",
  "always",
  "--log-driver",
  "json-file",
  "--log-opt",
  "max-size=10m",
  "--log-opt",
  "max-file=3",
  "--network",
  "host",
  "--security-opt",
  "apparmor=unconfined",
  "-v",
  "/etc/localtime:/etc/localtime:ro",
  "-v",
  "/var/lib/vmsingle:/storage",
  "-v",
  "/etc/anysda/vmsingle-scrape.yml:/etc/vm/scrape.yml:ro",
  "victoriametrics/victoria-metrics:v1.155.0",
  "-storageDataPath=/storage",
  "-httpListenAddr=127.0.0.1:8428",
  "-retentionPeriod=1d",
  "-memory.allowedBytes=32MiB",
  "-search.maxMemoryPerQuery=8MiB",
  "-search.maxConcurrentRequests=2",
  "-search.latencyOffset=1s",
  "-promscrape.config=/etc/vm/scrape.yml"
 ]
}